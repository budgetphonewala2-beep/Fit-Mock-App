import { mkdir, readFile, writeFile } from "node:fs/promises";
import path from "node:path";

const cwd = process.cwd();
const inputPath = path.join(cwd, "data", "exercise-videos.csv");
const outputDir = path.join(cwd, "src", "lib", "generated");
const outputPath = path.join(outputDir, "exercise-video-map.ts");

type CsvRow = Record<string, string>;

function parseCsv(content: string): CsvRow[] {
  const lines = content.split(/\r?\n/).filter((line) => line.trim().length > 0);

  if (lines.length === 0) {
    return [];
  }

  const headers = lines[0].split(",").map((header) => header.trim());

  return lines.slice(1).map((line) => {
    const values = line.split(",");
    const row: CsvRow = {};

    headers.forEach((header, index) => {
      row[header] = (values[index] ?? "").trim();
    });

    return row;
  });
}

async function main() {
  const csvContent = await readFile(inputPath, "utf-8");
  const rows = parseCsv(csvContent).filter((row) => row.r2_key);

  const publicUrl = (process.env.R2_PUBLIC_URL ?? "").replace(/\/+$/, "");

  const byId: Record<string, string> = {};
  const byName: Record<string, string> = {};

  for (const row of rows) {
    const url = publicUrl ? `${publicUrl}/${row.r2_key}` : `/${row.r2_key}`;

    if (row.exercise_id) {
      byId[row.exercise_id] = url;
    }

    if (row.exercise_name) {
      byName[row.exercise_name.trim().toLowerCase()] = url;
    }
  }

  const fileContents = `// Generated by scripts/generate-exercise-video-map.mts. Do not edit by hand.
// Run \`npm run videos:build\` after updating data/exercise-videos.csv.

export const exerciseVideoById: Record<string, string> = ${JSON.stringify(byId, null, 2)};

export const exerciseVideoByName: Record<string, string> = ${JSON.stringify(byName, null, 2)};
`;

  await mkdir(outputDir, { recursive: true });
  await writeFile(outputPath, fileContents, "utf-8");

  console.log(`Wrote ${rows.length} video entries to ${path.relative(cwd, outputPath)}`);
}

main().catch((error) => {
  console.error(error);
  process.exitCode = 1;
});
