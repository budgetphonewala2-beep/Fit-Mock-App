{
  "name": "fitmonk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "catalog:build": "node scripts/generate-food-catalog.mts",
    "videos:upload": "node --env-file=.env.local scripts/upload-exercise-videos.mts",
    "videos:build": "node --env-file=.env.local scripts/generate-exercise-video-map.mts",
    "landing:screenshots": "tsx scripts/capture-landing-screenshots.mts",
    "dev": "next dev -p 4000",
